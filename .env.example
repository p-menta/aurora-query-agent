# Random secret, at least 24 characters. Create with: openssl rand -hex 32
AGENT_TOKEN=
PORT=8443
# Bind to one address if you can (for example the node public IP). 0.0.0.0 = all.
BIND=0.0.0.0
# TLS: a copy of the node Let's Encrypt cert, made by deploy-hook.sh. Files reload every hour.
TLS_CERT=/certs/fullchain.pem
TLS_KEY=/certs/privkey.pem
# Extra CIDRs the agent may query, comma separated. Loopback, private ranges and this machine's own IPs are always allowed.
ALLOWED_CIDRS=
CONCURRENCY=20
QUERY_TIMEOUT_MS=2000
